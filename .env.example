# .env.example
# =============
# This is a TEMPLATE, safe to commit to Git - it has no real secrets in it,
# just the names of the environment variables the app expects.
#
# To actually use it:
#   1. Copy this file to a new file named exactly ".env" (same folder)
#   2. Replace the placeholder value below with your real Anthropic API key
#
# ".env" itself is listed in .gitignore, so it will never be committed -
# only you (and this machine) ever see the real value.
#
# IMPORTANT: never paste a real key into THIS file (.env.example) - only
# into .env. This file is meant to be committed to Git; .env is not.

# Get a key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_key_goes_here

# Connection string for your local PostgreSQL server - see app/config.py
# for the full postgresql://user:password@host:port/database_name format.
# Optional: app/config.py falls back to a sensible local default if this
# is unset, but setting it explicitly here is good practice, and required
# if your Postgres uses different credentials/port/database name.
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/your_database

# Google Sign-In (optional - hides the Google button when empty). Create an
# OAuth "Web application" client at console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# Admin console login (/admin). The account is created/updated from these on
# every server start. Use a strong password (min 8 chars); keep it in .env only.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# Emails (comma separated) that become "admin" on signup/sign-in. Set this to
# your own email to bootstrap the first admin.
ADMIN_EMAILS=you@example.com

# Set to true behind HTTPS so the session cookie is Secure.
COOKIE_SECURE=false

# SMTP for signup verification codes. With SMTP_HOST empty, codes are printed
# in the server console (development only). For Gmail use smtp.gmail.com,
# port 587, your address, and an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
